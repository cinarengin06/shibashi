{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "image": "sdk-57" },
      "ios": { "image": "sdk-57" }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "sdk-57"
      },
      "ios": { "image": "sdk-57" }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-57"
      },
      "ios": { "image": "sdk-57" }
    }
  }
}
